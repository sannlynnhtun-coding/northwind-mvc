@model PaginationVm

@{
    var prevPage = Math.Max(1, Model.Page - 1);
    var nextPage = Math.Min(Model.TotalPages, Model.Page + 1);
}

<nav aria-label="Page navigation" class="mt-3">
    <ul class="pagination">
        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
            <a class="page-link" href="?page=@prevPage&pageSize=@Model.PageSize&search=@Model.Search">Previous</a>
        </li>
        <li class="page-item disabled"><span class="page-link">Page @Model.Page / @Model.TotalPages</span></li>
        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="?page=@nextPage&pageSize=@Model.PageSize&search=@Model.Search">Next</a>
        </li>
    </ul>
</nav>
