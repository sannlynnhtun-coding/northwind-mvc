@model ShipperDetailsVm
@{
    ViewData["Title"] = "Delete Shipper";
}

<h2>Delete Shipper</h2>
<p class="text-danger">Deletion is blocked when orders reference this shipper.</p>

<div class="alert alert-warning">
    <strong>@Model.CompanyName</strong>
    <div>Referenced orders: @Model.OrderCount</div>
</div>

<form asp-action="Delete" asp-route-id="@Model.ShipperId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
