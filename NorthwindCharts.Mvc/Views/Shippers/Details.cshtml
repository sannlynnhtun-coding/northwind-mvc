@model ShipperDetailsVm
@{
    ViewData["Title"] = "Shipper Details";
}

<h2>Shipper Details</h2>
<dl class="row">
    <dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
    <dt class="col-sm-3">Orders</dt><dd class="col-sm-9">@Model.OrderCount</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ShipperId">Edit</a>
<a class="btn btn-secondary" asp-action="Index">Back</a>
