@model CustomerDetailsVm
@{
    ViewData["Title"] = "Customer Details";
}

<h2>Customer Details</h2>

<dl class="row">
    <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.CustomerId</dd>
    <dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd>
    <dt class="col-sm-3">Contact</dt><dd class="col-sm-9">@Model.ContactName (@Model.ContactTitle)</dd>
    <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address, @Model.City, @Model.Region, @Model.PostalCode, @Model.Country</dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
    <dt class="col-sm-3">Fax</dt><dd class="col-sm-9">@Model.Fax</dd>
</dl>

<h4>Recent Orders</h4>
<table class="table table-sm">
    <thead><tr><th>Order ID</th><th>Order Date</th><th>Shipped Date</th><th>Freight</th></tr></thead>
    <tbody>
    @foreach (var o in Model.RecentOrders)
    {
        <tr>
            <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderId">@o.OrderId</a></td>
            <td>@o.OrderDate?.ToString("yyyy-MM-dd")</td>
            <td>@o.ShippedDate?.ToString("yyyy-MM-dd")</td>
            <td>@o.Freight?.ToString("C")</td>
        </tr>
    }
    </tbody>
</table>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.CustomerId">Edit</a>
<a class="btn btn-secondary" asp-action="Index">Back</a>
