@model CustomerFormVm

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3 mb-3">
    <div class="col-md-2">
        <label asp-for="CustomerId" class="form-label"></label>
        <input asp-for="CustomerId" class="form-control" />
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>
    <div class="col-md-10">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ContactName" class="form-label"></label>
        <input asp-for="ContactName" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="ContactTitle" class="form-label"></label>
        <input asp-for="ContactTitle" class="form-control" />
    </div>

    <div class="col-md-12">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="col-md-3"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Region" class="form-label"></label><input asp-for="Region" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="PostalCode" class="form-label"></label><input asp-for="PostalCode" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" /></div>

    <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Fax" class="form-label"></label><input asp-for="Fax" class="form-control" /></div>
</div>
