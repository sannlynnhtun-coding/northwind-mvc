@model ProductDetailsVm
@{
    ViewData["Title"] = "Product Details";
}

<h2>Product Details</h2>

<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.ProductName</dd>
    <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.CategoryName</dd>
    <dt class="col-sm-3">Supplier</dt><dd class="col-sm-9">@Model.SupplierName</dd>
    <dt class="col-sm-3">Unit Price</dt><dd class="col-sm-9">@Model.UnitPrice?.ToString("C")</dd>
    <dt class="col-sm-3">In Stock</dt><dd class="col-sm-9">@Model.UnitsInStock</dd>
    <dt class="col-sm-3">On Order</dt><dd class="col-sm-9">@Model.UnitsOnOrder</dd>
    <dt class="col-sm-3">Reorder Level</dt><dd class="col-sm-9">@Model.ReorderLevel</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.Discontinued ? "Discontinued" : "Active")</dd>
</dl>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ProductId">Edit</a>
<a class="btn btn-secondary" asp-action="Index">Back</a>
