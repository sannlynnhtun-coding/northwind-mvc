@model OrderDeleteVm
@{
    ViewData["Title"] = "Delete Order";
}

<h2>Delete Order</h2>
<p class="text-danger">Shipped orders cannot be deleted.</p>

<div class="alert alert-warning">
    <div><strong>Order ID:</strong> @Model.OrderId</div>
    <div><strong>Customer:</strong> @Model.CustomerId</div>
    <div><strong>Order Date:</strong> @Model.OrderDate?.ToString("yyyy-MM-dd")</div>
    <div><strong>Status:</strong> @(Model.IsShipped ? "Shipped" : "Open")</div>
</div>

<form asp-action="Delete" asp-route-id="@Model.OrderId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger" @(Model.IsShipped ? "disabled" : null)>Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

