@model OrderEditVm
@{
    ViewData["Title"] = $"Order #{Model.OrderId}";
}

<h2>Order #@Model.OrderId</h2>
<p>Status: <strong>@(Model.IsShipped ? "Shipped" : "Open")</strong></p>

<dl class="row">
    <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.Header.CustomerId</dd>
    <dt class="col-sm-3">Required Date</dt><dd class="col-sm-9">@Model.Header.RequiredDate?.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Freight</dt><dd class="col-sm-9">@Model.Header.Freight?.ToString("C")</dd>
    <dt class="col-sm-3">Ship To</dt><dd class="col-sm-9">@Model.Header.ShipName, @Model.Header.ShipAddress, @Model.Header.ShipCity, @Model.Header.ShipCountry</dd>
</dl>

<h4>Order Lines</h4>
<table class="table table-sm">
    <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Discount</th><th>Subtotal</th></tr></thead>
    <tbody>
    @foreach (var line in Model.Lines)
    {
        <tr>
            <td>@line.ProductName</td>
            <td>@line.UnitPrice.ToString("C")</td>
            <td>@line.Quantity</td>
            <td>@line.Discount</td>
            <td>@line.LineSubtotal.ToString("C")</td>
        </tr>
    }
    </tbody>
</table>

<p><strong>Subtotal:</strong> @Model.Subtotal.ToString("C")</p>
<p><strong>Grand Total:</strong> @Model.GrandTotal.ToString("C")</p>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.OrderId">Edit</a>
<a class="btn btn-secondary" asp-action="Index">Back</a>
