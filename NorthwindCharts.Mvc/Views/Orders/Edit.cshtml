@model OrderEditPageVm
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = $"Edit Order #{Model.Order.OrderId}";
}

<h2>Edit Order #@Model.Order.OrderId</h2>
<p>Status: <strong>@(Model.Order.IsShipped ? "Shipped" : "Open")</strong></p>

<form asp-action="Edit" asp-route-id="@Model.Order.OrderId" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <partial name="_OrderHeaderForm" model="@(new OrderFormPageVm { Form = Model.Order.Header, Customers = Model.Customers, Shippers = Model.Shippers })" />
    @if (Model.Order.IsShipped)
    {
        <button type="submit" class="btn btn-primary" disabled>Save Header</button>
    }
    else
    {
        <button type="submit" class="btn btn-primary">Save Header</button>
    }
</form>

<div class="card mb-3">
    <div class="card-header">Order Lines</div>
    <div class="card-body">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                    <th>Discount</th>
                    <th>Line Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var line in Model.Order.Lines)
            {
                <tr>
                    <td>@line.ProductName</td>
                    <td>@line.UnitPrice.ToString("C")</td>
                    <td>
                        <form asp-action="UpdateLine" asp-route-id="@Model.Order.OrderId" asp-route-productId="@line.ProductId" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="number" name="Quantity" value="@line.Quantity" min="1" class="form-control form-control-sm" style="width:80px" @(Model.Order.IsShipped ? "disabled" : null) />
                            <input type="number" name="Discount" value="@line.Discount" min="0" max="0.5" step="0.01" class="form-control form-control-sm" style="width:90px" @(Model.Order.IsShipped ? "disabled" : null) />
                            <button class="btn btn-outline-primary btn-sm" type="submit" @(Model.Order.IsShipped ? "disabled" : null)>Update</button>
                        </form>
                    </td>
                    <td>@line.Discount</td>
                    <td>@line.LineSubtotal.ToString("C")</td>
                    <td>
                        <form asp-action="DeleteLine" asp-route-id="@Model.Order.OrderId" asp-route-productId="@line.ProductId" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-danger btn-sm" type="submit" @(Model.Order.IsShipped ? "disabled" : null)>Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <form asp-action="AddLine" asp-route-id="@Model.Order.OrderId" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-5">
                <label class="form-label">Product</label>
                @if (Model.Order.IsShipped)
                {
                    <select name="ProductId" class="form-select" asp-items="@(new SelectList(Model.ProductOptions, "Id", "Name"))" disabled></select>
                }
                else
                {
                    <select name="ProductId" class="form-select" asp-items="@(new SelectList(Model.ProductOptions, "Id", "Name"))"></select>
                }
            </div>
            <div class="col-md-2">
                <label class="form-label">Quantity</label>
                <input type="number" name="Quantity" value="1" min="1" class="form-control" @(Model.Order.IsShipped ? "disabled" : null) />
            </div>
            <div class="col-md-2">
                <label class="form-label">Discount</label>
                <input type="number" name="Discount" value="0" min="0" max="0.5" step="0.01" class="form-control" @(Model.Order.IsShipped ? "disabled" : null) />
            </div>
            <div class="col-md-3">
                <button class="btn btn-success w-100" type="submit" @(Model.Order.IsShipped ? "disabled" : null)>Add Line</button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <strong>Subtotal:</strong> @Model.Order.Subtotal.ToString("C")<br />
        <strong>Grand Total:</strong> @Model.Order.GrandTotal.ToString("C")
    </div>
    <form asp-action="Ship" asp-route-id="@Model.Order.OrderId" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-warning" type="submit" @(Model.Order.IsShipped ? "disabled" : null)>Ship Order</button>
    </form>
</div>

<a class="btn btn-secondary" asp-action="Index">Back to Orders</a>
