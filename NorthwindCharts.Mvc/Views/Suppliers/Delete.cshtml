@model SupplierDetailsVm
@{
    ViewData["Title"] = "Delete Supplier";
}

<h2>Delete Supplier</h2>
<p class="text-danger">Deletion is blocked when products reference this supplier.</p>

<div class="alert alert-warning">
    <strong>@Model.CompanyName</strong>
    <div>Referenced products: @Model.ProductCount</div>
</div>

<form asp-action="Delete" asp-route-id="@Model.SupplierId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
